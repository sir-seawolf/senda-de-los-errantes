    { "from": "tension", "to": "action", "fadeMs": 1500 },
    { "from": "tension", "to": "combat", "fadeMs": 1500 },
    { "from": "*", "to": "chase", "fadeMs": 1500 },
    { "from": "*", "to": "action", "fadeMs": 1500 },
    { "from": "*", "to": "combat", "fadeMs": 1500 },
    { "from": "combat", "to": "exploration", "fadeMs": 5000 },
    { "from": "chase", "to": "exploration", "fadeMs": 5000 },
    { "from": "action", "to": "exploration", "fadeMs": 5000 }
  ]
